# Copy this file to .env and fill in your keys

# ---- OpenAI (used ONLY for the chat/answer model) ----
OPENAI_API_KEY=sk-your-key-here
CHAT_MODEL=gpt-5.4-mini

# ---- Hugging Face embeddings (free, runs locally) ----
# Downloaded once from huggingface.co, then works offline.
#   BAAI/bge-small-en-v1.5  -> fast, small (~130 MB)          [default]
#   BAAI/bge-base-en-v1.5   -> more accurate (~440 MB)
#   BAAI/bge-m3             -> multilingual: Hindi/Tamil/etc. (~2.3 GB)
# After changing the model, run: python ingest.py
EMBED_MODEL=BAAI/bge-small-en-v1.5
# HF_TOKEN=hf_xxx   # optional - only for gated models or faster downloads

# ---- LangSmith tracing (track every question) ----
# Get a key at https://smith.langchain.com -> Settings -> API Keys
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_your-key-here
LANGSMITH_PROJECT=indian-civil-law-rag
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # only if your account is in the EU region

# ---- Retrieval settings ----
TOP_K=5            # chunks taken from BM25 and from FAISS (each)
BM25_WEIGHT=0.5    # 0.5 = equal mix; raise to 0.6-0.7 if you search a lot by section numbers

# ---- Folders (relative to the project folder) ----
DATA_DIR=data
INDEX_DIR=faiss_index
